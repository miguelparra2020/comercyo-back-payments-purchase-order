# Server Configuration
PORT=3001
NODE_ENV=development
PRODUCTION_URL=https://hbsb1-kardex.vercel.app

# CORS Configuration
# En producción, especifica los orígenes permitidos separados por coma
# Ejemplo: CORS_ORIGIN=https://miapp.com,https://www.miapp.com
CORS_ORIGIN=*

# Auth Configuration
# Access tokens are issued by the separate Comercyo users/auth backend
# (comercyo-back-users). This backend only verifies them - signature,
# expiry, and audience (JWT_AUDIENCE) - it never touches sessions or
# refresh tokens itself.
JWT_SECRET=                  # long random secret, HS256, same value the auth backend signs with
JWT_AUDIENCE=comercyo-internal   # must equal comercyo-back-users' JWT_AUDIENCE

# Cloudflare R2 Configuration
# PRIVATE bucket for purchase-order payment receipts, stored as
# purchase-orders/{orderId}/{receiptKey}. Do NOT enable a public URL on it:
# the API hands out short-lived presigned GET URLs instead.
# Create credentials in the Cloudflare dashboard: R2 > Manage R2 API Tokens
# (permission: Object Read & Write, scoped to this bucket).
R2_ACCOUNT_ID=                     # Cloudflare account id (also part of the S3 endpoint)
R2_ACCESS_KEY_ID=                  # from an R2 API Token
R2_SECRET_ACCESS_KEY=              # from an R2 API Token
R2_BUCKET_NAME=paymentspurchseordes
R2_SIGNED_URL_TTL_SECONDS=900      # optional, lifetime of the presigned URLs (default 900 = 15 min)

# --- Database (Supabase Postgres) -------------------------------------------
# Same database and values as comercyo-back-create-purchase-order. Used to
# check that the authenticated user owns the project of the purchase order
# (purchase_orders -> own_projects.created_by_email -> users).
# Builds: postgresql://postgres.<ref>:<password>@aws-xxx.pooler.supabase.com:6543/postgres
TIENDAS_DB_REF=
DATABASE_BASE=postgresql://postgres.
DATABASE_PASSWORD=
DATABASE_HOST=
